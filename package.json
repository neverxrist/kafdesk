{
  "name": "kafdesk",
  "productName": "KafDesk",
  "desktopName": "KafDesk",
  "version": "0.3.7",
  "description": "Friendly Kafka desktop client with Avro / JSON / String support",
  "author": {
    "name": "KafDesk contributors",
    "email": "kafdesk@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run tauri:dev",
    "dev:web": "vite",
    "tauri": "tauri",
    "tauri:dev": "node scripts/with-cmake.mjs tauri dev",
    "tauri:build": "node scripts/with-cmake.mjs tauri build",
    "build:web": "tsc --noEmit && vite build",
    "build": "npm run tauri:build",
    "build:mac": "node scripts/with-cmake.mjs tauri build --bundles dmg,app",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
